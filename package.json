{
  "name": "@laiye-adp/mcp",
  "version": "2.0.0-beta.2",
  "description": "Laiye ADP MCP server for document processing and official workflows",
  "type": "module",
  "bin": {
    "laiye-adp-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/node-mcp.test.mjs",
    "catalog:generate": "node scripts/generate-tool-catalog.mjs",
    "catalog:check": "node scripts/generate-tool-catalog.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
